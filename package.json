{
  "name": "kuyen-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs --out=.",
    "preview": "node tools/build.mjs --site=preview --out=dist-preview",
    "serve": "node tools/serve.mjs dist",
    "verify": "node tools/verify.mjs --port=8100",
    "test:ui": "node --experimental-websocket tools/pruebas-ui.mjs http://localhost:8100",
    "preview:publicar": "npm run preview && node tools/publicar-preview.mjs",
    "capturar": "node --experimental-websocket tools/capturar-tema.mjs"
  }
}
