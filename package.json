{
  "name": "kuyen-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/css/tailwind.css -o css/styles.css --minify",
    "build:html": "node tools/build.mjs --out=.",
    "build": "npm run build:css && npm run build:html",
    "preview": "node tools/build.mjs --site=preview --out=dist-preview",
    "serve": "node tools/serve.mjs dist",
    "verify": "node tools/verify.mjs --port=8099",
    "test:ui": "node --experimental-websocket tools/pruebas-ui.mjs http://localhost:8100"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.19"
  }
}
